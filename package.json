{
  "name": "rtl-markdown-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "build:export": "NODE_ENV=production NEXT_EXPORT=true next build",
    "build:desktop-frontend": "node scripts/prepare-tinyjs-frontend.mjs",
    "desktop:dev": "tinyjs dev",
    "desktop:build": "tinyjs build",
    "desktop:doctor": "tinyjs doctor",
    "predeploy": "npm run build:export",
    "deploy": "gh-pages -d out -t true",
    "start": "next start",
    "lint": "eslint .",
    "lint:oxlint": "oxlint types/tiny.ts utils/tinyDesktopBridge.ts hooks/useTinyDesktopIntegration.ts components/ui/pwa-install-button.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun tests/domain-contracts.test.ts && bun test tests/tiny-desktop-bridge.test.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:oxlint && npm run test",
    "clean": "next clean"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.2",
    "@fontsource/kode-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.0.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "devicon": "^2.18.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "lenis": "^1.3.26",
    "lucide-react": "^1.39.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@tailwindcss/postcss": "4.1.11",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "gh-pages": "^6.3.0",
    "oxlint": "1.90.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        "tools/oxlint/anti-slop/**",
        ".next/**",
        ".next-dev/**"
      ],
      "rules": [
        "react-doctor/react-markdown-unsanitized-raw-html"
      ]
    }
  }
}
